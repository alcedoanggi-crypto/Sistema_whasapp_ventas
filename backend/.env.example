# --- Base de datos ---
DATABASE_URL=postgresql+psycopg2://wa_app:wa_pass@localhost:5432/whatsapp_ventas
REDIS_URL=redis://localhost:6379/3

# --- Seguridad del panel ---
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=admin123
# Clave para que tu e-commerce/CRM envíe eventos (carrito, compra, pago) a /api/eventos
INTEGRATION_API_KEY=clave-integracion-demo

# --- WhatsApp ---
# sandbox = no envía nada real (simula estados y respuestas); cloud = API oficial de Meta
WHATSAPP_MODE=sandbox
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret de la app de Meta: se usa para verificar X-Hub-Signature-256
WHATSAPP_APP_SECRET=app-secret-demo
# Texto libre que tú eliges y pegas en el panel de Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=verify-token-demo

# --- Envío ---
# Mensajes por segundo (global, compartido por todos los workers)
RATE_LIMIT_MPS=20
MAX_REINTENTOS=5
# Días tras un mensaje de campaña en los que una compra se atribuye a esa campaña
VENTANA_ATRIBUCION_DIAS=7
# true = Celery ejecuta las tareas en el mismo proceso (demo sin worker ni Redis)
CELERY_EAGER=false

FRONTEND_ORIGIN=http://localhost:5174
